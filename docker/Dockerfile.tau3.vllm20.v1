# Tau3 latest-VERL image for vLLM V1 / vLLM 0.20.x smoke and training.
#
# This intentionally starts from vLLM's official OpenAI-compatible serving image.
# "openai" here means API-compatible server shape; the image does not call
# OpenAI. We use it as a pinned torch/vLLM/CUDA base to avoid ABI drift.

ARG BASE_IMAGE=vllm/vllm-openai:v0.20.1-cu129
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG TAU2_REPO=https://github.com/sierra-research/tau2-bench.git
ARG TAU2_COMMIT=220b47844fb74d4351037e81055cf1e2948e4734

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    VLLM_USE_V1=1 \
    VLLM_ALLREDUCE_USE_SYMM_MEM=0 \
    TAU2_DATA_DIR=/opt/tau2-bench/data \
    TAU3_VLLM_PROFILE=qwen35_v1 \
    HF_HOME=/root/.cache/huggingface

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        ninja-build \
        rsync \
        tmux \
        unzip \
        vim \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip setuptools wheel

# Install VERL/Tau3 Python dependencies without changing the torch/vLLM stack
# already pinned by the base image.
RUN python3 -m pip install \
        accelerate \
        addict \
        boto3 \
        codetiming \
        datasets \
        deepdiff \
        dill \
        "gymnasium>=1.2.2" \
        hydra-core \
        "litellm>=1.80.15,<1.82.7" \
        mathruler \
        "numpy<2.0.0" \
        pandas \
        peft \
        "pyarrow>=19.0.0" \
        pybind11 \
        pylatexenc \
        qwen-vl-utils \
        "ray[default]>=2.41.0" \
        tenacity \
        tensorboard \
        "tensordict>=0.8.0,<=0.10.0,!=0.9.0" \
        toml \
        torchdata \
        wandb

RUN git clone "${TAU2_REPO}" /opt/tau2-bench \
    && cd /opt/tau2-bench \
    && git checkout --detach "${TAU2_COMMIT}" \
    && python3 -m pip install -e /opt/tau2-bench --no-deps

WORKDIR /workspace/verl_tau3_sdpo
COPY . /workspace/verl_tau3_sdpo

RUN python3 -m pip install -e /workspace/verl_tau3_sdpo --no-deps \
    && python3 -m py_compile scripts/p5_preflight_vllm_v1.py \
    && python3 -c "import json, os, torch, vllm; from pathlib import Path; print(json.dumps({'torch': torch.__version__, 'torch_cuda': torch.version.cuda, 'vllm': vllm.__version__, 'vllm_use_v1': os.environ.get('VLLM_USE_V1'), 'cuda_runtime_h': str(Path('/usr/local/cuda/include/cuda_runtime.h'))}, sort_keys=True))"

ENTRYPOINT ["/bin/bash"]
